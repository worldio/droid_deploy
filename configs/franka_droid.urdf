  <link name="gripper/base">
    <inertial>
      <origin xyz="0 -2.70394e-05 0.0354675" rpy="-0.00305697762 0 0"/>
      <mass value="0.777441"/>
      <inertia ixx="0.000260285" iyy="0.000225381" izz="0.000152708" ixy="0" ixz="0" iyz="0"/>
