      <inertia ixx="0.0299291" iyy="0.0299291" izz="0.0299291" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fr3_joint2" type="revolute">
    <parent link="fr3_link1"/>
    <child link="fr3_link2"/>
    <origin xyz="0 0 0" rpy="-1.57079633 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7837" upper="1.7837" effort="100" velocity="3"/>
  </joint>
  <link name="fr3_link3">
    <inertial>
      <origin xyz="0.0407016 -0.00482006 -0.0289731" rpy="-0.24526042 0.502316821 0.250381941"/>
      <mass value="2.2449"/>
      <inertia ixx="0.0140109" iyy="0.0140109" izz="0.0140109" ixy="0" ixz="0" iyz="0"/>
