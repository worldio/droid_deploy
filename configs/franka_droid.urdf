      <mass value="0.0140974"/>
      <inertia ixx="4.16206e-06" iyy="3.52216e-06" izz="8.88131e-07" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="gripper/left_coupler_fixed" type="fixed">
    <parent link="gripper/left_driver"/>
    <child link="gripper/left_coupler"/>
    <origin xyz="-0.0314249 0.00453223 -0.0102" rpy="0 0 3.14159265"/>
  </joint>
  <link name="gripper/right_driver">
    <inertial>
      <origin xyz="2.96931e-12 0.0177547 0.00107314" rpy="1.64251517 0 0"/>
      <mass value="0.00899563"/>
      <inertia ixx="1.72352e-06" iyy="1.60906e-06" izz="3.22006e-07" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="gripper/right_driver_joint" type="revolute">
    <parent link="gripper/base"/>
    <child link="gripper/right_driver"/>
    <origin xyz="0.0306011 -0.00475 0.0657045" rpy="-1.57079633 0 -3.14159265"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.9" effort="100" velocity="3"/>
    <mimic joint="gripper/left_driver_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="gripper/right_coupler">
    <inertial>
      <origin xyz="0 0.00301209 0.0232175" rpy="0 0.129038547 1.57079633"/>
      <mass value="0.0140974"/>
      <inertia ixx="4.16206e-06" iyy="3.52216e-06" izz="8.88131e-07" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="gripper/right_coupler_fixed" type="fixed">
    <parent link="gripper/right_driver"/>
    <child link="gripper/right_coupler"/>
    <origin xyz="-0.0314249 0.00453223 -0.0102" rpy="0 0 3.14159265"/>
