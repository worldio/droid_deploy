<?xml version="1.0"?>
<!-- The DROID arm for FK: Franka Research 3 + Robotiq 2F-85, the kinematic tree of omniact-molmospaces' franka_droid
     (robots/franka_droid/20260127, model.xml + robotiq_2f85_v4/2f85.xml), which the training's franka_droid
     reference robot is measured from. Joints, limits and inertias are that model's; the gripper keeps what the
     node graph reads (base, drivers, couplers) and leaves out the spring links, followers and pads.
     fr3_link8 is the flange (the model's attachment_site), the frame of the Polymetis end-effector pose. -->
<robot name="franka_droid">
  <link name="world"/>
  <link name="fr3_link0">
  </link>
  <joint name="fr3_link0_fixed" type="fixed">
    <parent link="world"/>
    <child link="fr3_link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="fr3_link1">
    <inertial>
      <origin xyz="4.128e-07 -0.0181251 -0.0386036" rpy="0.00442229345 0.0085230535 0.0264849212"/>
      <mass value="2.92747"/>
      <inertia ixx="0.0186043" iyy="0.0181194" izz="0.00538716" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fr3_joint1" type="revolute">
    <parent link="fr3_link0"/>
    <child link="fr3_link1"/>
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.7437" upper="2.7437" effort="100" velocity="3"/>
  </joint>
  <link name="fr3_link2">
    <inertial>
      <origin xyz="0.00318289 -0.0743222 0.00881461" rpy="2.89151323 -1.25039523 -0.955770785"/>
